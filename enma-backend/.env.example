# ============================================================================
# enma-backend — environment variable template.
# Copy to .env and fill in real values. Never commit .env to git.
#
# Deployment stack:
#   Database   : Supabase (PostgreSQL 17, ap-northeast-1)
#   Vector RAG : pgvector on Supabase (ca_firm_rules)
#   Data RAG   : PageOne Index API (structured document data)
#   Deployment : AWS (Fargate for stateless, EKS for persistent)
# ============================================================================

# -- Runtime -----------------------------------------------------------------
ENV=development                # development | staging | production
LOG_LEVEL=info                 # debug | info | warning | error
APP_HOST=0.0.0.0
APP_PORT=8000

# -- Database (Supabase) -----------------------------------------------------
#
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
#
# Two modes — pick based on deployment target:
#
#   Session mode    (port 5432) — for EKS pods / local dev
#   Transaction mode (port 6543) — REQUIRED for Fargate (stateless)
#     When using port 6543, also set DB_POOL_SIZE=0 (Supavisor pools externally)
#
# Session mode example (local dev / EKS):
DATABASE_URL=postgresql+asyncpg://postgres.glozmtaqeahwneqaklus:Enmalabs040505@db.glozmtaqeahwneqaklus.supabase.co:5432/postgres
#
# Transaction mode example (Fargate):
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
#
# Pool — set to 0 for Fargate (transaction mode), 5-10 for EKS (session mode)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_S=30
DB_ECHO=false

# -- Inter-service auth (shared with gateway) --------------------------------
BACKEND_API_KEY=a91bd6836e1b3077a1a4084bf921678253349e7d71f93621f3d91b88e063ed0d
GATEWAY_HMAC_SECRET=d3666e225fb787cfdc5097b0a7b4156f18d4880d6b18a5f0a8124b38819b658d


# -- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=8097278960:AAEUsbcvKceBKdN4d6MG9ed-VNewLs8YZMo

# -- LLM model endpoints + API key (Phase 4+) ---------------------------------
#
# Provider : NVIDIA NIM  (OpenAI-compatible surface)
# Docs     : https://docs.api.nvidia.com/nim/reference/
#
# All three roles share the SAME base URL and the SAME API key;
# only the model name differs per role.
#
LLM_API_KEY=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

# Layout / document classification (fast — 8B class)
LAYOUT_MODEL_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
LAYOUT_MODEL_NAME=meta/llama-3.1-8b-instruct

# Structured extraction from invoices (OCR-aware, strong JSON mode)
EXTRACTION_MODEL_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
EXTRACTION_MODEL_NAME=nvidia/nemotron-ocr-v1

# Supervisor / reasoning / tax verdicts (70B class)
REASONING_MODEL_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
REASONING_MODEL_NAME=meta/llama-3.3-70b-instruct

# Embeddings for ca_firm_rules hybrid RAG (VECTOR(1024) column)
# ⚠  Use nv-embedqa-e5-v5 — it produces EXACTLY 1024 dims.
#    Do NOT use nv-embedcode-7b-v1 (code embeddings, wrong domain).
EMBEDDING_ENDPOINT=https://integrate.api.nvidia.com/v1/embeddings
EMBEDDING_MODEL_NAME=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIMENSIONS=1024

# Voice transcription (NVIDIA NIM audio endpoint)
WHISPER_ENDPOINT=https://integrate.api.nvidia.com/v1/audio/transcriptions

# -- PageOne Index API (vectorless RAG over Supabase structured data) --------
# Used by the Supervisor Agent to answer natural language questions about
# extracted documents, ITC data, and filing history.
# Separate from pgvector RAG which handles ca_firm_rules retrieval.
PAGEONE_API_KEY=3de9bdb3221e4570994003688be5d922
PAGEONE_INDEX_ENDPOINT=    # e.g. https://api.pageone.ai/v1

# -- AWS deployment ----------------------------------------------------------
# Leave blank for local dev — AWS profiles are used.
AWS_ACCOUNT_ID=            # e.g. 123456789012
AWS_IAM_ROLE=              # e.g. arn:aws:iam::123456789012:role/enma-backend-task
FARGATE_SERVICE_URL=       # e.g. https://backend.enma.in

# -- Observability -----------------------------------------------------------
SENTRY_DSN=https://8f946c8634edd204fac97e0836a45277@o4511108882497536.ingest.de.sentry.io/4511519498305616
SENTRY_TRACES_SAMPLE_RATE=0.1
