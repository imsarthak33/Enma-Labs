# ============================================================================
# enma-backend — environment variable template.
# Copy to .env and fill in real values. Never commit .env to git.
#
# Deployment stack:
#   Database   : Supabase (PostgreSQL 17, ap-northeast-1)
#   Vector RAG : pgvector on Supabase (ca_firm_rules)
#   Data RAG   : PageOne Index API (structured document data)
#   Deployment : GCP (Cloud Run for stateless, GKE for persistent)
# ============================================================================

# -- Runtime -----------------------------------------------------------------
ENV=development                # development | staging | production
LOG_LEVEL=info                 # debug | info | warning | error
APP_HOST=0.0.0.0
APP_PORT=8000

# -- Database (Supabase) -----------------------------------------------------
#
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
#
# Two modes — pick based on deployment target:
#
#   Session mode    (port 5432) — for GKE pods / local dev
#   Transaction mode (port 6543) — REQUIRED for Cloud Run (stateless)
#     When using port 6543, also set DB_POOL_SIZE=0 (Supavisor pools externally)
#
# Session mode example (local dev / GKE):
DATABASE_URL=postgresql+asyncpg://postgres.glozmtaqeahwneqaklus:Enmalabs040505@db.glozmtaqeahwneqaklus.supabase.co:5432/postgres
#
# Transaction mode example (Cloud Run):
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
#
# Pool — set to 0 for Cloud Run (transaction mode), 5-10 for GKE (session mode)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_S=30
DB_ECHO=false

# -- Inter-service auth (shared with gateway) --------------------------------
BACKEND_API_KEY=dev_backend_api_key_change_me
GATEWAY_HMAC_SECRET=dev_hmac_secret_change_me

# -- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=8097278960:AAEUsbcvKceBKdN4d6MG9ed-VNewLs8YZMo

# -- LLM model endpoints (Phase 4+) ------------------------------------------
# All provider-agnostic — point at OpenAI, Anthropic, or NVIDIA NIM endpoints.
LAYOUT_MODEL_ENDPOINT=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
EXTRACTION_MODEL_ENDPOINT=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
REASONING_MODEL_ENDPOINT=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
WHISPER_ENDPOINT=
EMBEDDING_ENDPOINT=        # For pgvector RAG on ca_firm_rules
SUMMARIZATION_ENDPOINT=

# -- PageOne Index API (vectorless RAG over Supabase structured data) --------
# Used by the Supervisor Agent to answer natural language questions about
# extracted documents, ITC data, and filing history.
# Separate from pgvector RAG which handles ca_firm_rules retrieval.
PAGEONE_API_KEY=3de9bdb3221e4570994003688be5d922
PAGEONE_INDEX_ENDPOINT=    # e.g. https://api.pageone.ai/v1

# -- GCP deployment ----------------------------------------------------------
# Leave blank for local dev — Application Default Credentials (ADC) are used.
GCP_PROJECT_ID=            # e.g. enma-labs-prod
GCP_SERVICE_ACCOUNT=       # e.g. enma-backend@enma-labs-prod.iam.gserviceaccount.com
CLOUD_RUN_SERVICE_URL=     # e.g. https://enma-backend-xxx-an.a.run.app

# -- Observability -----------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
