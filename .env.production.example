# =============================================================================
# Enma Labs — Production environment template.
#
# Copy to `.env.production` on the deploy host (or set each value in the
# orchestrator's secret store — AWS Secrets Manager / Fly secrets / Railway
# variables). NEVER commit the populated file. The audit script
# (scripts/security_audit.py #18) enforces that.
#
# Every secret value here SHOULD come from a managed secret store in
# real production — env files are appropriate for staging or single-host
# bootstrap only.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
ENV=production
LOG_LEVEL=info
APP_HOST=0.0.0.0
APP_PORT=8000
WEB_CONCURRENCY=2

# ---- Database (Supabase — session mode for long-lived process) --------------
# Use session mode (port 5432) for EKS / Fargate pods. Transaction mode
# (port 6543) is only correct for stateless Cloud Run / Lambda.
# sslmode=require is MANDATORY — the audit script asserts this string.
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ---- Inter-service auth (rotate quarterly — see docs/SECRET_ROTATION.md) ---
BACKEND_API_KEY=<64-hex-bytes>
GATEWAY_HMAC_SECRET=<64-hex-bytes>

# ---- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=<bot-token-from-botfather>

# ---- LLM endpoints + key (NVIDIA NIM) -------------------------------------
# Provider: NVIDIA NIM — https://docs.api.nvidia.com/nim/reference/
# All three roles share the same base URL + API key; model name varies.
LLM_API_KEY=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

# Layout / classification (fast, 8B class)
LAYOUT_MODEL_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
LAYOUT_MODEL_NAME=meta/llama-3.1-8b-instruct

# Structured extraction from invoices (OCR-aware, strong JSON mode)
EXTRACTION_MODEL_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
EXTRACTION_MODEL_NAME=nvidia/nemotron-ocr-v1

# Supervisor / reasoning / tax verdicts (70B class)
REASONING_MODEL_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
REASONING_MODEL_NAME=meta/llama-3.3-70b-instruct

# Embeddings — MUST use nv-embedqa-e5-v5 (1024 dims, text domain).
# nv-embedcode-7b-v1 is a code embedding model — wrong for tax documents.
EMBEDDING_ENDPOINT=https://integrate.api.nvidia.com/v1/embeddings
EMBEDDING_MODEL_NAME=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIMENSIONS=1024

# Voice transcription (NVIDIA NIM audio endpoint)
WHISPER_ENDPOINT=https://integrate.api.nvidia.com/v1/audio/transcriptions
SERPER_API_KEY=<serper-api-key>

# Phase 6 — PageOne vectorless RAG
PAGEONE_API_KEY=<pageone-api-key>
PAGEONE_INDEX_ENDPOINT=https://api.pageone.io/index/v1

# ---- Observability ---------------------------------------------------------
SENTRY_DSN=<sentry-dsn-for-production-project>
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Cache (ElastiCache Serverless — TLS REQUIRED) --------------------------
# The deploy_aws.ps1 script provisions this and emits the rediss:// URL
# at the end of the run. Substitute the real endpoint below.
REDIS_URL=rediss://enma-cache-<id>.serverless.<region>.cache.amazonaws.com:6379/0

# ---- Rate limiting ---------------------------------------------------------
RATE_LIMIT_DEFAULT=100/minute

# ---- CORS — explicit allowlist; '*' is rejected outside development ---------
CORS_ORIGINS=["https://app.enma.in"]

# ---- AWS metadata ----------------------------------------------------------
AWS_ACCOUNT_ID=<aws-account-id>
AWS_IAM_ROLE=arn:aws:iam::<aws-account-id>:role/enma-backend-task
FARGATE_SERVICE_URL=https://backend.enma.in
