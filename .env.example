# Root-level environment for docker-compose. Service-level .env.example files
# inside each repo document the per-service variables in more depth.

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=8097278960:AAEUsbcvKceBKdN4d6MG9ed-VNewLs8YZMo

# ---- Postgres ----
POSTGRES_DB=enma_dev
POSTGRES_USER=enma
POSTGRES_PASSWORD=dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Inter-service auth ----
# Shared secret used by the gateway to HMAC-sign envelopes the backend then verifies.
BACKEND_API_KEY=dev_backend_api_key_change_me
GATEWAY_HMAC_SECRET=dev_hmac_secret_change_me

# ---- Backend ----
BACKEND_URL=http://backend:8000
LOG_LEVEL=info
ENV=development

# ---- Sentry (optional in dev) ----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
